rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return signedIn() && request.auth.token.role == 'Admin';
    }

    // Each signed-in user can read and write ONLY their own data.
    // The app writes to users/{uid}/{assessments, checkIns, appointments,
    // emergencyContacts, pregnancyNotes, profile}, to
    // users/{uid}/vitals/{type}/entries, to users/{uid}/medications,
    // and to users/{uid}/medicationLogs.
    match /users/{userId}/{document=**} {
      allow read, write: if isOwner(userId);
    }

    // Public doctor directory: any signed-in user may read; admins maintain it.
    match /doctor_profiles/{id} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    // Public emergency locations (hospitals & clinics): anyone may read.
    match /emergency_locations/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Admins (custom claim role == 'Admin') have full platform access.
    match /{document=**} {
      allow read, write: if isAdmin();
    }
  }
}
